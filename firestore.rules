rules_version = '2';

// Hestia security rules.
// Inventory data (rooms, containers, items) is readable/writable only by
// members of the household it belongs to. Household documents themselves are
// readable by any signed-in user so a partner can look one up by invite code.
service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    function householdMembers(hid) {
      return get(/databases/$(database)/documents/households/$(hid)).data.memberIds;
    }

    function isMember(hid) {
      return isSignedIn() && request.auth.uid in householdMembers(hid);
    }

    match /users/{uid} {
      allow read: if isSignedIn();
      allow create, update: if isSignedIn() && request.auth.uid == uid;
      allow delete: if false;
    }

    match /households/{hid} {
      // Any signed-in user can read household docs (needed to join by code).
      allow read: if isSignedIn();
      allow create: if isSignedIn()
        && request.auth.uid in request.resource.data.memberIds;
      // Updates allowed for existing members, or a user adding themselves.
      allow update: if isMember(hid)
        || (isSignedIn() && request.auth.uid in request.resource.data.memberIds);
      allow delete: if false;

      // Rooms, containers and items live under the household.
      match /{document=**} {
        allow read, write: if isMember(hid);
      }
    }
  }
}
