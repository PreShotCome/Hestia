rules_version = '2';

// Photos are stored under households/{householdId}/... and are accessible
// only to members of that household.
service firebase.storage {
  match /b/{bucket}/o {
    match /households/{hid}/{allPaths=**} {
      allow read, write: if request.auth != null
        && request.auth.uid in
          firestore.get(/databases/(default)/documents/households/$(hid)).data.memberIds;
    }
  }
}
